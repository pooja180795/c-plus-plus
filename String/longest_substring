// Online C++ compiler to run C++ program online
#include <iostream>
#include <climits>
#include <unordered_map>
using namespace std;

int main() {
    string s = "pwwkew";
    int len = INT_MIN;
    int n = s.length();
    unordered_map<char, int> m;
    int curr = 0;
    
    for(int i = 0; i< n; i++){
        if(m.find(s[i])==m.end()){
            curr++;
            m[s[i]] = 1;
        }
        else{
            len = max(curr, len);
            curr = 0;
            m.clear();
        }
    }
    cout << max(curr,len)<< endl;
    return 0;
}
